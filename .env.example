# =============================================================================
# Website Growth Lab — environment variables
# Copy to .env for local development. In production, add these in
# Vercel → Project → Settings → Environment Variables. NEVER commit real values.
# =============================================================================

# --- Site -------------------------------------------------------------------
# Public URL of the site, no trailing slash. e.g. https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (PostgreSQL, e.g. Supabase) -----------------------------------
# Supabase: Project → Connect → "Transaction pooler" (port 6543) for DATABASE_URL
# (append ?pgbouncer=true&connection_limit=1) and "Session pooler" (port 5432) for DIRECT_URL.
# Do NOT use the "Direct connection" host db.<project>.supabase.co: it is IPv6-only and fails from Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Admin authentication ---------------------------------------------------
# Long random string (min 32 chars). Generate with: openssl rand -base64 48
# Changing it signs out all admins and invalidates customer order links.
AUTH_SECRET=""

# --- First admin (optional, created automatically during the build) -----------
# Creates this admin on the next deploy if it doesn't exist yet. Password: 12+ chars, upper/lower case + number.
# After you can sign in at /admin/login, DELETE ADMIN_PASSWORD from Vercel.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Automatic database setup during `npm run build` -------------------------
# The build creates/updates tables and loads starter categories + pages. Set to "true" to turn this off.
SKIP_DB_SETUP="false"
# Demo ebooks are added only to an empty store AND only when Supabase Storage is configured. "false" = never.
SEED_DEMO_PRODUCTS="true"

# --- File storage -----------------------------------------------------------
# "local" (development only) or "supabase" (production)
STORAGE_DRIVER="local"
SUPABASE_URL=""
# Service role key: server-side only. Never expose it in client code or NEXT_PUBLIC_ vars.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="covers"
SUPABASE_PRIVATE_BUCKET="ebooks"

# --- Payments ---------------------------------------------------------------
# "razorpay" for real checkout, "mock" for local testing only, or leave empty to disable checkout.
PAYMENT_PROVIDER="mock"
# Currencies your payment account is ACTUALLY enabled to charge (comma-separated).
# Razorpay: INR by default; other currencies only after International Payments is approved.
PAYMENT_CURRENCIES="INR,USD"
# Only for test deployments: allows the mock provider when NODE_ENV=production. Never "true" on a live store.
ALLOW_MOCK_PAYMENTS="false"

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_… keys until you are ready to go live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The secret you type when creating the webhook (Dashboard → Webhooks).
RAZORPAY_WEBHOOK_SECRET=""

# --- Email (optional) -------------------------------------------------------
# Resend (resend.com) API key and a verified sender, e.g. "Website Growth Lab <orders@yourdomain.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Delivery policy (optional) ---------------------------------------------
DOWNLOAD_MAX_COUNT="10"
# 0 = links never expire
DOWNLOAD_EXPIRY_DAYS="0"
